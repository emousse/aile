{
  "name": "aile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && tsup server/index.ts server/extract-worker.ts --format esm --out-dir dist/server --splitting false --clean",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "node --import tsx scripts/production-smoke.ts",
    "test:live": "node --import tsx scripts/production-smoke.ts --live",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@mozilla/readability": "0.6.0",
    "fastify": "5.12.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
