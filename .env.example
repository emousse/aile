# Copie ce fichier vers .env. Rien ici n’est une clé réelle.
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Sans ces deux valeurs : lecture réelle disponible, IA explicitement inactive.
# Choisir un modèle compatible Responses + Structured Outputs dans ton compte.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optionnel : recherche sur le Web avec Brave. Sans clé : Wikipédia uniquement.
BRAVE_SEARCH_API_KEY=

# Vide = sites HTTPS publics. Liste exacte, séparée par des virgules, pour un pilote encadré.
# Ceci est une restriction d’essai, pas un système de classification des contenus.
ALLOWED_HOSTS=

# En production, renseigner ces deux secrets et servir derrière HTTPS.
# Génération du secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=
# Login HTTP Basic : pilote. Mot de passe requis en production, >= 12 caractères.
PILOT_PASSWORD=
